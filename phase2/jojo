        <?php

        $catResult = $conn->query("SELECT * FROM Category ORDER BY ID");

        while ($cat = $catResult->fetch_assoc()) {

            $categoryName = $cat['category'];
            $categoryID = (int)$cat['ID'];

            echo '<section class="category-section">';

            echo '<h3 class="category-title">';
            echo 'Books in ' . htmlspecialchars($categoryName) . ' Category';
            echo '</h3>';

            echo '<ul class="horizontal-scroll">';


            $booksResult = $conn->query(
                "SELECT * FROM Books
                 WHERE categoryID = $categoryID
                 ORDER BY title"
            );


            while ($book = $booksResult->fetch_assoc()) {

                $isbn = $book['ISBN'];
                $title = $book['title'];

                $imagePath =
                    "BookCovers/"
                    . $categoryName
                    . "/"
                    . $isbn
                    . ".png";


                echo '<li class="book-item">';

                echo '<a class="book-link"
                         href="displayBook.php?isbn='
                         . urlencode($isbn)
                         . '">';


                echo '<img class="book-cover"
                         src="'
                         . htmlspecialchars($imagePath)
                         . '"
                         alt="'
                         . htmlspecialchars($title)
                         . '">';


                echo '<span class="book-title">';
                echo htmlspecialchars($title);
                echo '</span>';


                echo '</a>';

                echo '</li>';
            }


            echo '</ul>';

            echo '</section>';
        }


        $conn->close();

        ?>

    </main>


    <footer class="site-footer">
        <p>Book Library</p>
    </footer>

