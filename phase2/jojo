/* =========================
   General Page Style
   ========================= */

* {
    box-sizing: border-box;
}

body {
    margin: 0;
    font-family: Arial, Helvetica, sans-serif;
    background-color: #f5f7fb;
    color: #253044;
}


/* =========================
   Header
   ========================= */

.site-header {
    background-color: #ffffff;
    border-bottom: 1px solid #dfe5ee;
    padding: 18px 35px;
    box-shadow: 0 2px 8px rgba(0, 0, 0, 0.05);
}

.brand {
    display: flex;
    align-items: center;
    gap: 15px;
}

.logo {
    width: 65px;
    height: 65px;
    object-fit: contain;
}

.brand-text h1 {
    margin: 0;
    font-size: 28px;
    color: #203864;
}

.brand-text p {
    margin: 4px 0 0;
    color: #7a8496;
    font-size: 14px;
}


/* =========================
   Main Page
   ========================= */

.library-container {
    max-width: 1200px;
    margin: 0 auto;
    padding: 35px 30px;
}

.page-heading {
    margin-bottom: 35px;
}

.page-heading h2 {
    margin: 0;
    font-size: 32px;
    color: #203864;
}

.page-heading p {
    margin-top: 8px;
    color: #7a8496;
}


/* =========================
   Category
   ========================= */

.category-section {
    margin-bottom: 40px;
}

.category-title {
    font-size: 21px;
    color: #334e78;
    margin-bottom: 14px;
}


/* =========================
   Horizontal Book List
   ========================= */

.horizontal-scroll {
    display: flex;
    overflow-x: auto;
    gap: 20px;

    list-style: none;

    margin: 0;
    padding: 22px;

    background-color: #ffffff;

    border: 1px solid #e1e6ef;
    border-radius: 12px;

    scroll-behavior: smooth;
}


/* Scroll bar */

.horizontal-scroll::-webkit-scrollbar {
    height: 8px;
}

.horizontal-scroll::-webkit-scrollbar-track {
    background-color: #eef1f5;
    border-radius: 10px;
}

.horizontal-scroll::-webkit-scrollbar-thumb {
    background-color: #aeb9ca;
    border-radius: 10px;
}


/* =========================
   Book Card
   ========================= */

.book-item {
    flex: 0 0 auto;
    width: 145px;
}

.book-link {
    display: block;

    text-decoration: none;
    color: #253044;

    background-color: #ffffff;

    padding: 10px;

    border: 1px solid transparent;
    border-radius: 10px;

    transition:
        transform 0.2s ease,
        box-shadow 0.2s ease,
        border-color 0.2s ease;
}

.book-link:hover {
    transform: translateY(-5px);

    border-color: #cbd5e1;

    box-shadow:
        0 8px 18px
        rgba(0, 0, 0, 0.12);
}


/* =========================
   Book Cover
   ========================= */

.book-cover {
    display: block;

    width: 125px;
    height: 185px;

    object-fit: cover;

    margin: 0 auto;

    border-radius: 6px;

    box-shadow:
        0 3px 10px
        rgba(0, 0, 0, 0.15);
}


/* =========================
   Book Title
   ========================= */

.book-title {
    display: block;

    margin-top: 10px;

    font-size: 13px;
    font-weight: bold;

    line-height: 1.4;

    text-align: center;
}


/* =========================
   Footer
   ========================= */

.site-footer {
    margin-top: 30px;
    padding: 20px;

    text-align: center;

    background-color: #ffffff;

    border-top: 1px solid #dfe5ee;

    color: #7a8496;

    font-size: 13px;
}


/* =========================
   Responsive Design
   ========================= */

@media (max-width: 600px) {

    .site-header {
        padding: 15px 20px;
    }

    .library-container {
        padding: 25px 15px;
    }

    .brand-text h1 {
        font-size: 23px;
    }

    .page-heading h2 {
        font-size: 26px;
    }
}
